// Static public site + authenticated procurement API. No credentials in this file.
{
  "name": "boltnote",
  "main": "worker/index.mjs",
  "compatibility_date": "2025-09-01",
  "keep_vars": true,
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/", "/googlee7950c29a2b5a35e.html", "/naver873356c1ec7239a24ea882fae7172928.html"]
  },
  "durable_objects": {
    "bindings": [{"name": "PROCUREMENT", "class_name": "ProcurementStore"}]
  },
  "migrations": [{"tag": "procurement-v1", "new_sqlite_classes": ["ProcurementStore"]}],
  "triggers": {"crons": ["*/5 * * * *"]},
  "workers_dev": true,
  "preview_urls": true
}
