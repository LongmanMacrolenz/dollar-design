// Static public site + authenticated procurement API. No credentials in this file.
// /count is the one public write address: it takes a screen or button name and keeps daily totals only (worker/index.mjs countPing).
{
  "name": "boltnote",
  "main": "worker/index.mjs",
  "compatibility_date": "2025-09-01",
  "keep_vars": true,
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "not_found_handling": "404-page",   // 없는 주소에는 docs/404.html을 404 상태로 보낸다 (site/build_lib.py not_found_html)
    // 임시(2026-11-14 주소 이전): 옛 주소(workers.dev)·www의 301 이동을 위해 모든 요청이 워커를 거친다. 이전 2~3개월 뒤 workers_dev를 끄고 이 값을 원래 목록으로 되돌린다(AGENTS.md).
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{"name": "PROCUREMENT", "class_name": "ProcurementStore"}]
  },
  "migrations": [{"tag": "procurement-v1", "new_sqlite_classes": ["ProcurementStore"]}],
  "triggers": {"crons": ["*/5 * * * *"]},
  "workers_dev": true,
  "preview_urls": true
}
