// Cloudflare Workers 정적 사이트 설정: docs/ 폴더만 공개합니다.
// Worker 이름은 Cloudflare 대시보드의 Worker 이름(boltnote)과 같아야 합니다.
// preview_urls는 켜 둡니다. main이 아닌 브랜치(PR) 빌드는 `wrangler preview`로 미리보기 주소를 만드는데, 끄면 그 빌드가 실패합니다.
{
  "name": "boltnote",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./docs"
  },
  "workers_dev": true,
  "preview_urls": true
}
